<Application x:Class="LGClimaTray.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#101719"/>
    <SolidColorBrush x:Key="Panel" Color="#192326"/>
    <SolidColorBrush x:Key="PanelLight" Color="#223034"/>
    <SolidColorBrush x:Key="Accent" Color="#9BE6D0"/>
    <SolidColorBrush x:Key="Muted" Color="#9AAEAB"/>
    <SolidColorBrush x:Key="TextMain" Color="#F0F7F5"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="Background" Value="{StaticResource PanelLight}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F0F7F5"/><Setter Property="Background" Value="#263638"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8"/><Setter Property="FontSize" Value="13"/>
    </Style>
  </Application.Resources>
</Application>
