<Window x:Class="LGClimaTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LG Clima" Width="370" Height="720" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI" Foreground="{StaticResource TextMain}">
  <Window.Resources>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="4,9"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#263638"/><Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="CaretBrush" Value="{StaticResource TextMain}"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,7"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>
  <Border Background="{StaticResource Bg}" CornerRadius="24" BorderBrush="#2C4140" BorderThickness="1" Padding="22">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#263B39" CornerRadius="12" Width="42" Height="42"><TextBlock Text="❄" FontSize="23" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="LG CLIMA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/><TextBlock Text="Controle do ambiente" FontSize="16" FontWeight="SemiBold"/></StackPanel>
        </StackPanel>
        <Button Content="×" Width="34" Height="34" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Click="CloseButton_Click" Background="#263034" FontSize="20"/>
      </Grid>
      <Border Grid.Row="1" Margin="0,18,0,16" Padding="14,10" CornerRadius="12" Background="#172D2A">
        <DockPanel><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#F0C674" VerticalAlignment="Center"/><TextBlock x:Name="StatusText" Text="Modo de demonstração" Foreground="{StaticResource Accent}" FontSize="12" Margin="9,0,0,0" VerticalAlignment="Center"/><TextBlock Text="S4NW12JA3XB" Foreground="{StaticResource Muted}" FontSize="10" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
      </Border>

      <Grid Grid.Row="2">
        <!-- Main panel -->
        <StackPanel x:Name="MainPanel">
          <Border Background="{StaticResource Panel}" CornerRadius="20" Padding="18,14">
            <StackPanel>
              <Grid><TextBlock Text="TEMPERATURA DEFINIDA" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/><TextBlock x:Name="PowerBadge" Text="DESLIGADO" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right"/></Grid>
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Width="44" Height="44" Padding="0" FontSize="22" Content="–" VerticalAlignment="Center" Click="TempDown_Click" ToolTip="Diminuir 0,5°"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock x:Name="TemperatureText" Text="23" FontSize="64" FontWeight="Light"/><TextBlock Text="°" FontSize="30" Margin="1,9,0,0" Foreground="{StaticResource Accent}"/></StackPanel>
                <Button Grid.Column="2" Width="44" Height="44" Padding="0" FontSize="22" Content="+" VerticalAlignment="Center" Click="TempUp_Click" ToolTip="Aumentar 0,5°"/>
              </Grid>
              <TextBlock x:Name="RoomTemperatureText" Text="Ambiente: —" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
              <Slider x:Name="TemperatureSlider" Minimum="18" Maximum="30" Value="23" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="TemperatureSlider_ValueChanged" Foreground="{StaticResource Accent}"/>
              <DockPanel Margin="0,2,0,0"><TextBlock Text="18°" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="30°" Foreground="{StaticResource Muted}" FontSize="10" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
            </StackPanel>
          </Border>
          <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="PowerButton" Grid.Column="0" Background="{StaticResource Accent}" Foreground="#10221E" FontWeight="Bold" Padding="12,12" Click="PowerButton_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontWeight="Normal" FontSize="14" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock x:Name="PowerButtonText" Text="Ligar aparelho" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Content="↻   Recolher" Padding="12,12" Click="CloseButton_Click"/>
          </Grid>

          <TextBlock Text="MODO DE OPERAÇÃO" Style="{StaticResource SectionLabel}" Margin="2,16,0,7"/>
          <UniformGrid Columns="3" Rows="2">
            <Button x:Name="CoolButton" Content="❄  Frio" Margin="0,0,6,6" Click="Cool_Click"/>
            <Button x:Name="HeatButton" Content="☼  Quente" Margin="0,0,6,6" Click="Heat_Click"/>
            <Button x:Name="AutoButton" Content="◉  Auto" Margin="0,0,0,6" Click="Auto_Click"/>
            <Button x:Name="FanModeButton" Content="≋  Ventilar" Margin="0,0,6,0" Click="FanMode_Click"/>
            <Button x:Name="DryButton" Content="♧  Secar" Margin="0,0,6,0" Click="Dry_Click"/>
            <Button Content="⚙  Ajustes" Click="Settings_Click"/>
          </UniformGrid>

          <TextBlock Text="VELOCIDADE DO VENTILADOR" Style="{StaticResource SectionLabel}" Margin="2,16,0,7"/>
          <UniformGrid Columns="4">
            <Button x:Name="FanAutoButton" Style="{StaticResource Chip}" Content="Auto" Tag="Automatico" Margin="0,0,6,0" Click="Fan_Click"/>
            <Button x:Name="FanLowButton" Style="{StaticResource Chip}" Content="Baixo" Tag="Baixo" Margin="0,0,6,0" Click="Fan_Click"/>
            <Button x:Name="FanMidButton" Style="{StaticResource Chip}" Content="Médio" Tag="Medio" Margin="0,0,6,0" Click="Fan_Click"/>
            <Button x:Name="FanHighButton" Style="{StaticResource Chip}" Content="Alto" Tag="Alto" Click="Fan_Click"/>
          </UniformGrid>

          <TextBlock Text="RECURSOS" Style="{StaticResource SectionLabel}" Margin="2,16,0,7"/>
          <UniformGrid Columns="4">
            <Button x:Name="SwingVerticalButton" Style="{StaticResource Chip}" Content="↕ Vertical" Margin="0,0,6,0" Click="SwingVertical_Click" ToolTip="Oscilação vertical das aletas"/>
            <Button x:Name="SwingHorizontalButton" Style="{StaticResource Chip}" Content="↔ Lateral" Margin="0,0,6,0" Click="SwingHorizontal_Click" ToolTip="Oscilação horizontal das aletas"/>
            <Button x:Name="NaturalWindButton" Style="{StaticResource Chip}" Content="≈ Natural" Margin="0,0,6,0" Click="NaturalWind_Click" ToolTip="Vento natural"/>
            <Button x:Name="PowerSaveButton" Style="{StaticResource Chip}" Content="Economia" Click="PowerSave_Click" ToolTip="Economia de energia"/>
          </UniformGrid>
        </StackPanel>

        <!-- Settings panel -->
        <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
          <DockPanel Margin="0,0,0,12">
            <Button Content="←  Voltar" Padding="12,8" Click="SettingsBack_Click"/>
            <TextBlock Text="AJUSTES" Style="{StaticResource SectionLabel}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
          </DockPanel>

          <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="14" Margin="0,0,0,10">
            <DockPanel>
              <StackPanel VerticalAlignment="Center"><TextBlock Text="LUZ DO DISPLAY" Style="{StaticResource SectionLabel}"/><TextBlock Text="Visor de temperatura no aparelho" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
              <Button x:Name="DisplayLightButton" Style="{StaticResource Chip}" Content="Acesa" Width="90" HorizontalAlignment="Right" Click="DisplayLight_Click"/>
            </DockPanel>
          </Border>

          <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="14" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="DESLIGAR DAQUI A (SLEEP)" Style="{StaticResource SectionLabel}"/>
              <UniformGrid Columns="5" Margin="0,8,0,0">
                <Button Style="{StaticResource Chip}" Content="30 min" Tag="30" Margin="0,0,5,0" Click="Sleep_Click"/>
                <Button Style="{StaticResource Chip}" Content="1 h" Tag="60" Margin="0,0,5,0" Click="Sleep_Click"/>
                <Button Style="{StaticResource Chip}" Content="2 h" Tag="120" Margin="0,0,5,0" Click="Sleep_Click"/>
                <Button Style="{StaticResource Chip}" Content="4 h" Tag="240" Margin="0,0,5,0" Click="Sleep_Click"/>
                <Button Style="{StaticResource Chip}" Content="✕" Tag="0" Click="Sleep_Click" ToolTip="Cancelar sleep"/>
              </UniformGrid>
              <TextBlock x:Name="SleepStatusText" Text="Nenhum sleep ativo" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="14" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="PROGRAMAR HORÁRIO" Style="{StaticResource SectionLabel}"/>
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="Ligar às" VerticalAlignment="Center" FontSize="12"/>
                <TextBox x:Name="StartTimeBox" Grid.Column="1" Text="" ToolTip="Ex.: 07:30"/>
                <Button Grid.Column="2" Style="{StaticResource Chip}" Content="Definir" Padding="10,7" Margin="6,0,0,0" Click="StartTimeSet_Click"/>
                <Button Grid.Column="3" Style="{StaticResource Chip}" Content="✕" Padding="10,7" Margin="5,0,0,0" Click="StartTimeClear_Click" ToolTip="Cancelar"/>
                <TextBlock Grid.Row="2" Text="Desligar às" VerticalAlignment="Center" FontSize="12"/>
                <TextBox x:Name="StopTimeBox" Grid.Row="2" Grid.Column="1" Text="" ToolTip="Ex.: 23:00"/>
                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource Chip}" Content="Definir" Padding="10,7" Margin="6,0,0,0" Click="StopTimeSet_Click"/>
                <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource Chip}" Content="✕" Padding="10,7" Margin="5,0,0,0" Click="StopTimeClear_Click" ToolTip="Cancelar"/>
              </Grid>
              <TextBlock x:Name="TimerStatusText" Text="Nenhum horário programado" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="14" Margin="0,0,0,10">
            <DockPanel>
              <TextBlock Text="FILTRO" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
              <TextBlock x:Name="FilterText" Text="—" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>

          <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="14">
            <StackPanel>
              <TextBlock Text="CONEXÃO" Style="{StaticResource SectionLabel}"/>
              <TextBlock x:Name="ConnectionInfoText" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <TextBlock x:Name="FooterText" Grid.Row="3" Text="" Foreground="{StaticResource Muted}" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </Grid>
  </Border>
</Window>
